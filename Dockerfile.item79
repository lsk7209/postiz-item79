# Match the currently deployed upstream bytes; rebuild customized app code.
FROM ghcr.io/gitroomhq/postiz-app@sha256:1e376ff2cb781022d528f171719cf174cf693a985a30cb40eefb13eae3ddda13
COPY libraries/helpers/src/utils/channel-account.ts /app/libraries/helpers/src/utils/channel-account.ts
COPY apps/frontend/src/components/launches/launches.component.tsx /app/apps/frontend/src/components/launches/launches.component.tsx
COPY apps/frontend/src/components/launches/channel-account-label.tsx /app/apps/frontend/src/components/launches/channel-account-label.tsx
COPY apps/frontend/src/components/launches/settings.modal.tsx /app/apps/frontend/src/components/launches/settings.modal.tsx
COPY apps/backend/src/api/routes/integrations.controller.ts /app/apps/backend/src/api/routes/integrations.controller.ts
COPY libraries/nestjs-libraries/src/database/prisma/integrations/integration.repository.ts /app/libraries/nestjs-libraries/src/database/prisma/integrations/integration.repository.ts
COPY libraries/nestjs-libraries/src/database/prisma/integrations/integration.service.ts /app/libraries/nestjs-libraries/src/database/prisma/integrations/integration.service.ts
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm --filter ./apps/backend run build && NODE_OPTIONS="--max-old-space-size=4096" pnpm --filter ./apps/frontend run build
ARG ITEM79_REVISION=development
LABEL org.opencontainers.image.source="https://github.com/lsk7209/postiz-item79"
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"
LABEL org.opencontainers.image.revision=$ITEM79_REVISION
